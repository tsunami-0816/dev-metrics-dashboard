# .env.example 模板（dev-metrics-dashboard · 无外部服务 C07）
# ============================================
# 使用说明：
# 1. 复制为 .env，填入实际值（本工具无密码/密钥类配置）
# 2. 所有配置项必须和代码里的配置一一对应（app/db.py load_config）
# ============================================

# 项目元信息
PROJECT_NAME=dev-metrics-dashboard

# 后端服务（D-29 仅回环监听 / D-30 端口约定）
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8091

# SQLite 库路径（相对路径基于 backend 目录；collect.py 重建）
DB_PATH=data/metrics.db

# 前端（5B 填）：Vite dev 端口
FRONTEND_PORT=5184
